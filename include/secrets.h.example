#pragma once

// ============================================================================
//  MODELO das credenciais - versao entram no Git
//
//  Copie este arquivo para include/secrets.h e preencha os valores reais.
//  include/secrets.h e ignorado pelo Git (ver .gitignore).
//
//  O arquivo e unico para os dois ambientes: a escolha entre TESTE e
//  PRODUCAO continua sendo feita exclusivamente por TEST_MODE (config.h).
//
//  Todos os valores abaixo usam placeholders "COLOQUE_..." para que o projeto
//  compile antes de o usuario informar os valores reais (credentials.h
//  detecta o prefixo e o firmware nao tenta conectar enquanto houver
//  credencial pendente). NENHUM valor real neste arquivo.
// ============================================================================

#include <stdint.h>

// Wi-Fi - teste
constexpr char WIFI_SSID_TEST[]     = "COLOQUE_O_SSID_DO_WIFI_DE_TESTE";
constexpr char WIFI_PASSWORD_TEST[] = "COLOQUE_A_SENHA_DO_WIFI_DE_TESTE";

// Wi-Fi - producao
constexpr char WIFI_SSID_PROD[]     = "COLOQUE_O_SSID_DE_PRODUCAO";
constexpr char WIFI_PASSWORD_PROD[] = "COLOQUE_A_SENHA_DO_WIFI_DE_PRODUCAO";

// Broker MQTT/TLS (ThingsBoard). Host e porta sao os mesmos nos dois
// ambientes: a infraestrutura usa MQTT sobre TLS na porta 8883.
// Nao existe porta 1883 no MoniRes: texto puro nao e usado.
constexpr char TB_HOST[]     = "mqtt.datalog.top";
constexpr uint16_t TB_PORT   = 8883;

// Tokens de acesso dos dispositivos no ThingsBoard.
constexpr char TB_ACCESS_TOKEN_TEST[] = "COLOQUE_O_TOKEN_DO_DISPOSITIVO_DE_TESTE";
constexpr char TB_ACCESS_TOKEN_PROD[] = "COLOQUE_O_TOKEN_DO_DISPOSITIVO_DE_PRODUCAO";

// Telegram - Bot API.
//
// O bot e consultado diretamente pelo ESP32 (sem servico intermediario).
// Somente o(s) chat(s) abaixo podem executar comandos e receber respostas:
// qualquer outro chat e ignorado silenciosamente.
//
// TELEGRAM_CHAT_ID2_* e um segundo chat autorizado OPCIONAL: deixe vazio ("")
// quando nao houver. Os IDs sao tratados como inteiros de 64 bits (grupos comecam
// com "-100" e nao cabem em 32 bits).

// Telegram - teste
constexpr char TELEGRAM_BOT_TOKEN_TEST[] = "COLOQUE_O_TOKEN_DO_BOT_DE_TESTE";
constexpr char TELEGRAM_CHAT_ID_TEST[]   = "COLOQUE_O_CHAT_ID_AUTORIZADO_DE_TESTE";
constexpr char TELEGRAM_CHAT_ID2_TEST[]  = "";

// Telegram - producao
constexpr char TELEGRAM_BOT_TOKEN_PROD[] = "COLOQUE_O_TOKEN_DO_BOT_DE_PRODUCAO";
constexpr char TELEGRAM_CHAT_ID_PROD[]   = "COLOQUE_O_CHAT_ID_AUTORIZADO_DE_PRODUCAO";
constexpr char TELEGRAM_CHAT_ID2_PROD[]  = "";
